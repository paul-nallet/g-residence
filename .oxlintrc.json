{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["public/**", "node_modules/**", ".wrangler/**"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "unicorn/no-array-sort": "off",
    "no-underscore-dangle": ["warn", { "allow": ["_tag"] }],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  }
}
