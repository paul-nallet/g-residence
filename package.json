{
  "name": "gresidence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "predev": "npm run db:local && npm run build",
    "frontend": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test \"test/**/*.test.ts\"",
    "precheck": "npm run build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && wrangler deploy --dry-run",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.ts",
    "db:seed:reset": "node scripts/seed.ts --reset",
    "db:remote:status": "wrangler d1 migrations list DB --remote",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run check && npm run db:remote && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@astryxdesign/cli": "^0.7.3",
    "@astryxdesign/core": "^0.7.3",
    "@astryxdesign/theme-neutral": "^0.7.3",
    "@stylexjs/stylex": "^0.19.1",
    "effect": "^4.0.6",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  }
}
